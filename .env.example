# Working product name. This is the only place you should need to override it locally.
NEXT_PUBLIC_APP_NAME=Вместе

# Public Supabase values only. Never put service_role or secret keys in NEXT_PUBLIC_*.
# Leave these empty only for the safe local development demo.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional canonical URL. Locally this can be http://localhost:3000.
# On Vercel it may stay empty: server actions derive the current HTTPS origin safely.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Closed beta must remain hidden from search engines.
# Change to true only for a deliberate public release after the release review.
NEXT_PUBLIC_ALLOW_INDEXING=false
