diff -ruN a/src/features/imports/pdf-compat.test.ts b/src/features/imports/pdf-compat.test.ts
--- a/src/features/imports/pdf-compat.test.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/features/imports/pdf-compat.test.ts	2026-09-01 11:37:24.339052072 +0000
@@ -0,0 +1,47 @@
+import { afterEach, describe, expect, it } from "vitest";
+import { ensurePdfJsPromiseCompatibility } from "./pdf-compat";
+
+type PromiseWithResolvers = <T>() => {
+  promise: Promise<T>;
+  resolve: (value: T | PromiseLike<T>) => void;
+  reject: (reason?: unknown) => void;
+};
+
+type PromiseTry = <T, Args extends readonly unknown[]>(
+  callback: (...args: Args) => T | PromiseLike<T>,
+  ...args: Args
+) => Promise<T>;
+
+type PdfJsPromiseConstructor = {
+  withResolvers?: PromiseWithResolvers;
+  try?: PromiseTry;
+};
+
+const promiseConstructor = Promise as unknown as PdfJsPromiseConstructor;
+const originalWithResolvers = promiseConstructor.withResolvers;
+const originalTry = promiseConstructor.try;
+
+afterEach(() => {
+  promiseConstructor.withResolvers = originalWithResolvers;
+  promiseConstructor.try = originalTry;
+});
+
+describe("PDF.js Promise compatibility", () => {
+  it("polyfills Promise.withResolvers and Promise.try when the browser does not provide them", async () => {
+    promiseConstructor.withResolvers = undefined;
+    promiseConstructor.try = undefined;
+
+    ensurePdfJsPromiseCompatibility();
+
+    const capability = promiseConstructor.withResolvers!<number>();
+    capability.resolve(42);
+    await expect(capability.promise).resolves.toBe(42);
+
+    await expect(promiseConstructor.try!((value: number) => value * 2, 21)).resolves.toBe(42);
+    await expect(
+      promiseConstructor.try!(() => {
+        throw new Error("boom");
+      }),
+    ).rejects.toThrow("boom");
+  });
+});
diff -ruN a/src/features/imports/pdf-compat.ts b/src/features/imports/pdf-compat.ts
--- a/src/features/imports/pdf-compat.ts	1970-01-01 00:00:00.000000000 +0000
+++ b/src/features/imports/pdf-compat.ts	2026-09-01 11:37:24.338929307 +0000
@@ -0,0 +1,51 @@
+type PromiseWithResolvers = <T>() => {
+  promise: Promise<T>;
+  resolve: (value: T | PromiseLike<T>) => void;
+  reject: (reason?: unknown) => void;
+};
+
+type PromiseTry = <T, Args extends readonly unknown[]>(
+  callback: (...args: Args) => T | PromiseLike<T>,
+  ...args: Args
+) => Promise<T>;
+
+type PdfJsPromiseConstructor = {
+  withResolvers?: PromiseWithResolvers;
+  try?: PromiseTry;
+};
+
+/**
+ * PDF.js 6.x calls Promise.withResolvers and Promise.try. Older Safari/WKWebView
+ * versions do not provide one or both methods, including some iPhones that can
+ * otherwise run the app. Install only the missing helpers before PDF.js loads.
+ */
+export function ensurePdfJsPromiseCompatibility(): void {
+  const promiseConstructor = Promise as unknown as PdfJsPromiseConstructor;
+
+  if (typeof promiseConstructor.withResolvers !== "function") {
+    promiseConstructor.withResolvers = function withResolvers<T>() {
+      let resolve!: (value: T | PromiseLike<T>) => void;
+      let reject!: (reason?: unknown) => void;
+      const promise = new Promise<T>((onResolve, onReject) => {
+        resolve = onResolve;
+        reject = onReject;
+      });
+      return { promise, resolve, reject };
+    };
+  }
+
+  if (typeof promiseConstructor.try !== "function") {
+    promiseConstructor.try = function promiseTry<T, Args extends readonly unknown[]>(
+      callback: (...args: Args) => T | PromiseLike<T>,
+      ...args: Args
+    ): Promise<T> {
+      return new Promise<T>((resolve, reject) => {
+        try {
+          resolve(callback(...args));
+        } catch (error) {
+          reject(error);
+        }
+      });
+    };
+  }
+}
